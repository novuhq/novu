NEXT_PUBLIC_NOVU_APP_ID=
NEXT_PUBLIC_NOVU_SUBSCRIBER_ID=
NEXT_PUBLIC_NOVU_AGENT_ID=
NEXT_PUBLIC_NOVU_BACKEND_URL=http://localhost:3000

# Cloudflare socket worker (local wrangler): http://127.0.0.1:8787 + socketType=cloud
# Nest apps/ws (legacy socket.io): http://localhost:3002 + omit SOCKET_TYPE / use self-hosted
NEXT_PUBLIC_NOVU_SOCKET_URL=http://127.0.0.1:8787
NEXT_PUBLIC_NOVU_SOCKET_TYPE=cloud

# Optional when production HMAC is enabled
# NEXT_PUBLIC_NOVU_SUBSCRIBER_HASH=
