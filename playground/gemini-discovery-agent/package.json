{
  "name": "gemini-discovery-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "npx novu@latest dev -p 4111 --no-studio --route /api/novu --run \"npm start\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novu/framework": "2.14.0",
    "express": "5.2.1",
    "google-auth-library": "11.1.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
