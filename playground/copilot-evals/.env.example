# Commented-out values are the defaults.

# LangSmith EU workspace — the key must be created in eu.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=

# Dataset the experiments run against (created by `pnpm dataset:sync`)
# EVAL_DATASET=copilot-workflow-tools

# Local Novu API and the secret key of the environment Copilot should work in
# NOVU_API_URL=http://localhost:3000
NOVU_SECRET_KEY=

# LangSmith projects the API itself traces into (its LANGSMITH_PROJECT); used to pull tokens,
# LLM calls and the tools:direct / tools:mcp tag. Defaults to copilot-<variant>.
# API_TRACE_PROJECT_DIRECT=copilot-direct
# API_TRACE_PROJECT_MCP=copilot-mcp

# true keeps the workflows Copilot creates so you can open them in the dashboard
# KEEP_WORKFLOWS=false

# Examples run one at a time by default so latency stays comparable between variants
# EVAL_CONCURRENCY=1
# TURN_TIMEOUT_MS=300000
