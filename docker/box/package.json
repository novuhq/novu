{
  "name": "novu-box",
  "private": true,
  "type": "module",
  "description": "Novu Box: the Novu Cloud stack in one container, locally or on Cloudflare. Not part of the pnpm workspace.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "box": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "alchemy deploy --stage prod"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "22.20.5",
    "alchemy": "2.0.0-beta.83",
    "typescript": "6.0.3"
  }
}
