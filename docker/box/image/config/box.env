# The host adds the box's own URLs (API_ROOT_URL, S3_LOCAL_STACK, ...: its public address) at start
# (boxEnv in src/cloud/container.ts).
VITE_WEBSOCKET_TYPE=cloud

# All boxes share this Clerk app. The publishable key and issuer are public; CLERK_SECRET_KEY is a secret
# passed at bake and start. A new Clerk instance issues v2 session tokens, so its session claims add the
# v1 org_id, org_role, org_slug and org_permissions that the API reads.
NODE_ENV=production
IS_SELF_HOSTED=false
NOVU_ENTERPRISE=true
EE_AUTH_PROVIDER=clerk
VITE_EE_AUTH_PROVIDER=clerk
CLERK_ISSUER_URL=https://electric-sponge-6737.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_ZWxlY3RyaWMtc3BvbmdlLTY3MzcuY2xlcmsuYWNjb3VudHMuZGV2JA
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZWxlY3RyaWMtc3BvbmdlLTY3MzcuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=
DISABLE_USER_REGISTRATION=false

STRIPE_API_KEY=

API_INTERNAL_ORIGIN=http://127.0.0.1:3000

MONGO_URL=mongodb://127.0.0.1:27017/novu-box?replicaSet=rs0&directConnection=true
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_POOL_SIZE=50
MONGO_AUTO_CREATE_INDEXES=false
IS_IN_MEMORY_CLUSTER_MODE_ENABLED=true
MEMORY_DB_CLUSTER_SERVICE_HOST=127.0.0.1
MEMORY_DB_CLUSTER_SERVICE_PORT=7000
ELASTICACHE_CLUSTER_SERVICE_HOST=127.0.0.1
ELASTICACHE_CLUSTER_SERVICE_PORT=7000
REDIS_HOST=127.0.0.1
REDIS_PORT=7000
REDIS_TLS={}
NOVU_SAFE_OUTBOUND_ALLOW=mail.box.internal,sink.box.internal,bridge.box.internal
CLICK_HOUSE_URL=http://127.0.0.1:8123
CLICK_HOUSE_USER=default
CLICK_HOUSE_PASSWORD=
CLICK_HOUSE_DATABASE=novu-box
S3_BUCKET_NAME=novu-box
S3_REGION=us-east-1
# Jobs go through SQS (ElasticMQ in the box) like on staging and production. Delays over 900s go to
# BullMQ instead of EventBridge Scheduler, which has no working emulator.
QUEUE_BACKEND=sqs_bullmq
SQS_ENDPOINT=http://127.0.0.1:9324
AWS_REGION=eu-west-2
SQS_QUEUE_URL_STANDARD=http://127.0.0.1:9324/000000000000/novu-standard
SQS_QUEUE_URL_WORKFLOW=http://127.0.0.1:9324/000000000000/novu-workflow
SQS_QUEUE_URL_PROCESS_SUBSCRIBER=http://127.0.0.1:9324/000000000000/novu-process-subscriber
SQS_QUEUE_URL_WEB_SOCKETS=http://127.0.0.1:9324/000000000000/novu-web-sockets
SQS_QUEUE_URL_INBOUND_PARSE_MAIL=http://127.0.0.1:9324/000000000000/novu-inbound-parse-mail
SQS_PAYLOAD_OFFLOAD_BUCKET=novu-box

JWT_SECRET=box-fake-jwt-secret
STORE_ENCRYPTION_KEY=boxfakestoreencryptionkey0123456
INTERNAL_SERVICES_API_KEY=box-fake-internal-services-key
NOVU_SECRET_KEY=box-fake-novu-secret-key

SOCKET_WORKER_URL=http://127.0.0.1:8887
IS_CLOUDFLARE_SOCKETS_ENABLED=true
IS_LEGACY_WS_SERVICE_DISABLED=true
THALAMUS_CF_URL=http://127.0.0.1:8788
THALAMUS_CF_API_KEY=box-fake-thalamus-key
THALAMUS_WEBHOOK_SECRET=box-fake-thalamus-webhook-secret
MAX_NOVU_MANAGED_CLAUDE_CONVERSATIONS=200

VITE_LAUNCH_DARKLY_CLIENT_SIDE_ID=63cd8d6be5107812e3a46de6
LAUNCH_DARKLY_SDK_KEY=

NEW_RELIC_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
IS_API_RATE_LIMITING_ENABLED=false
WIDGET_BASE_URL=
LOG_LEVEL=info
IS_TRACE_LOGS_ENABLED=true
IS_STEP_RUN_LOGS_WRITE_ENABLED=true
IS_WORKFLOW_RUN_LOGS_WRITE_ENABLED=true
IS_ANALYTICS_LOGS_ENABLED=true

NODE_OPTIONS=--max-old-space-size=768
PM2_INSTANCES=1
NEW_RELIC_NO_CONFIG_FILE=true
