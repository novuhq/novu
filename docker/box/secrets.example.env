# Runtime secrets for a Novu Box. Names only: copy to docker/box/.env (gitignored and dockerignored, chmod 600),
# fill in preview-only values, and start the box with `docker run --env-file docker/box/.env ...`.
# A box runs PR code, and that code can read its env: never production keys, and staging keys only
# when they can't change anything (the LaunchDarkly SDK key only reads flags).

# LaunchDarkly project `default`, environment `dev` (the one staging uses): server-side SDK key.
LAUNCH_DARKLY_SDK_KEY=

# Clerk app `novu-box` (app_3KN3iEbdMZ8XqqRpi3hIC6wzzLE), development instance: `clerk env pull --instance dev`.
# Needed at bake too (it seeds the user and org) and by smoke.mjs (`node --env-file=docker/box/.env`).
CLERK_SECRET_KEY=

# The dashboard password of the seed user (agent@novu.co). Box URLs are public, so it's a secret; each
# bake sets it on the Clerk user. Generate one: `openssl rand -base64 24`. Share it through the password manager.
BOX_SEED_PASSWORD=

# Stripe sandbox `Novu Box` (acct_1UODPmFKxZbFmwjX): secret key (sk_test_...). Needed at bake (it puts the
# seeded org on Team) and at start (webhooks through `stripe listen`).
STRIPE_API_KEY=

# Optional. Anthropic key for managed agents (Novu-managed Claude), from a workspace with a monthly spend limit,
# never Novu's production key. With it, start runs thalamus and seeds the `box-managed` agent, and the bridge app's
# AI SDK and LangChain agents run on Claude (as ANTHROPIC_API_KEY) instead of scripted fakes.
NOVU_MANAGED_CLAUDE_API_KEY=
