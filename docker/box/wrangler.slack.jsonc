{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novu-box-slack",
  "main": "src/cloud/thin.ts",
  "account_id": "33ec6e8088201ace372678be50170681",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "BOX", "class_name": "Router", "script_name": "novu-box-hub" }]
  },
  "vars": { "BOX_NAME": "router" }
}
