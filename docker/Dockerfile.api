# =============================================================================
# ReNovu API - Self-Hosted Build
# =============================================================================
# Simplified Dockerfile that builds the API from source without requiring
# pre-generated Nx build artifacts.
# =============================================================================

FROM node:20-alpine3.20 AS builder

RUN apk add --no-cache g++ make py3-pip bash
ENV NX_DAEMON=false

WORKDIR /usr/src/app

RUN npm install -g pnpm@10.16.1 --loglevel notice

# Copy package files first for better caching
COPY .npmrc .
COPY package.json .
COPY pnpm-workspace.yaml .
COPY pnpm-lock.yaml .
COPY nx.json .
COPY tsconfig.json .

# Copy source code
COPY apps/api ./apps/api
COPY libs ./libs
COPY packages ./packages
COPY enterprise ./enterprise

# Install dependencies
RUN --mount=type=cache,id=pnpm-store-api,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile --unsafe-perm

# Build API
RUN NODE_ENV=production pnpm build:api --skip-nx-cache

# Copy env files
WORKDIR /usr/src/app/apps/api
RUN cp src/dotenvcreate.mjs dist/dotenvcreate.mjs || true
RUN cp src/.example.env dist/.env || true
RUN cp src/.env.development dist/.env.development || true
RUN cp src/.env.production dist/.env.production || true

# =============================================================================
# Production Stage
# =============================================================================
FROM node:20-alpine3.20

RUN apk add --no-cache g++ make py3-pip
RUN npm install -g pnpm@10.16.1 pm2 --loglevel notice

USER 1000
WORKDIR /usr/src/app

# Copy all necessary files from builder (including workspace packages)
COPY --chown=1000:1000 --from=builder /usr/src/app/node_modules ./node_modules
COPY --chown=1000:1000 --from=builder /usr/src/app/packages ./packages
COPY --chown=1000:1000 --from=builder /usr/src/app/libs ./libs
COPY --chown=1000:1000 --from=builder /usr/src/app/enterprise ./enterprise
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/api/node_modules ./apps/api/node_modules
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/api/dist ./apps/api/dist
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/api/package.json ./apps/api/package.json

WORKDIR /usr/src/app/apps/api

ENV NEW_RELIC_NO_CONFIG_FILE=true

EXPOSE 3000

CMD ["pm2-runtime", "start", "dist/main.js", "-i", "max"]
