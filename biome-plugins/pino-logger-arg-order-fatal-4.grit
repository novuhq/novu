// Flags reversed pino arg order: logger.fatal(message, { ... })
// Pino expects: logger.fatal({ ... }, message)

engine biome(1.0)
language js(typescript)

`$_.fatal($_, { $_: $_, $_: $_, $_: $_, $_: $_ })` where {
  register_diagnostic(
    span = $match,
    severity = "warn",
    message = "Pino expects (object, message). Use logger.fatal({ ... }, message) instead of logger.fatal(message, { ... })."
  )
}
