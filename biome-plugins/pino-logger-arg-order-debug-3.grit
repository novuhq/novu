// Flags reversed pino arg order: logger.debug(message, { ... })
// Pino expects: logger.debug({ ... }, message)

engine biome(1.0)
language js(typescript)

`$_.debug($_, { $_: $_, $_: $_, $_: $_ })` where {
  register_diagnostic(
    span = $match,
    severity = "warn",
    message = "Pino expects (object, message). Use logger.debug({ ... }, message) instead of logger.debug(message, { ... })."
  )
}
