// Flags reversed pino arg order: logger.trace(message, { ... })
// Pino expects: logger.trace({ ... }, message)

engine biome(1.0)
language js(typescript)

`$_.trace($_, { $_: $_, $_: $_, $_: $_, $_: $_, $_: $_ })` where {
  register_diagnostic(
    span = $match,
    severity = "warn",
    message = "Pino expects (object, message). Use logger.trace({ ... }, message) instead of logger.trace(message, { ... })."
  )
}
