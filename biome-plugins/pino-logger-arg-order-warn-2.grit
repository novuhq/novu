// Flags reversed pino arg order: logger.warn(message, { ... })
// Pino expects: logger.warn({ ... }, message)

engine biome(1.0)
language js(typescript)

`$_.warn($_, { $_: $_, $_: $_ })` where {
  register_diagnostic(
    span = $match,
    severity = "warn",
    message = "Pino expects (object, message). Use logger.warn({ ... }, message) instead of logger.warn(message, { ... })."
  )
}
