// Ensures MongoDB session properties in *.command.ts files have @Exclude() decorator
// MongoDB sessions must be excluded from command serialization to prevent serialization issues
// Note: This rule flags ALL session properties. Verify @Exclude() is present above the property.

engine biome(1.0)
language js(typescript)

// Match session as a property name
// This matches "session" when it appears as a property identifier in a class
`session` where {
  register_diagnostic(
    span = $match,
    severity = "error",
    message = "MongoDB ClientSession property detected. VERIFY @Exclude() decorator is present above this property to prevent serialization issues."
  )
}
