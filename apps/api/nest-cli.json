{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "typeCheck": true,
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [".js", ".ts", ".jsx", ".tsx"],
        "ignore": ["**/*.spec.ts", "**/*.e2e.ts", "**/*.e2e-ee.ts"],
        "stripLeadingPaths": true
      }
    },
    "assets": [
      {
        "include": ".env",
        "outDir": "dist"
      },
      {
        "include": ".env.development",
        "outDir": "dist"
      },
      {
        "include": ".env.test",
        "outDir": "dist"
      },
      {
        "include": ".env.production",
        "outDir": "dist"
      }
    ],
    "plugins": []
  }
}
