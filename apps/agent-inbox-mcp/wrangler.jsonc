{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-inbox-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Variables, per environment below:
  //   AGENT_INBOX_API_URL  the Agent Inbox Dashboard API (the dashboard's `/api`); every tool calls it as the account
  //   NOVU_API_URL         the Novu API, only asked for the account's key with the dashboard secret: the one call
  //                        the Dashboard API doesn't offer
  //   OPENAI_APPS_CHALLENGE  the token OpenAI gives to verify the domain for the ChatGPT app, served at
  //                          `/.well-known/openai-apps-challenge`; set on staging and production
  // Secrets, set per environment with `wrangler secret put <NAME> --env <env>` (local: `.dev.vars`):
  //   AGENT_INBOX_DASHBOARD_API_SECRET  the secret the Agent Inbox dashboard shares with the Novu API
  //   CLERK_SECRET_KEY                  the Agent Inbox Clerk app's secret key, optional: tells Grok Bot from the
  //                                     Cursor editor by its sign-in app, as both connect as Cursor
  "env": {
    // Local development against a local dashboard and API. Sign-in needs the Agent Inbox Clerk app's address in
    // CLERK_OAUTH_ISSUER; put it in `.dev.vars` next to the secret.
    "local": {
      "name": "agent-inbox-mcp-local",
      "workers_dev": true,
      "vars": {
        "CLERK_OAUTH_ISSUER": "https://exact-haddock-1045.clerk.accounts.dev",
        "AGENT_INBOX_API_URL": "http://localhost:4300/api",
        "NOVU_API_URL": "http://localhost:3000",
        "DOCS_URL": "http://localhost:4300"
      },
      // Kept by `wrangler dev` in `.wrangler/state`, never deployed: connected apps show on the local dashboard,
      // and its onboarding moves on when an app signs in.
      "kv_namespaces": [{ "binding": "CONNECTIONS", "id": "local-connections" }]
    },
    "staging": {
      "name": "agent-inbox-mcp-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "mcp-staging.agentinbox.md",
          "custom_domain": true
        }
      ],
      "vars": {
        "CLERK_OAUTH_ISSUER": "https://select-foal-365.clerk.accounts.dev",
        "AGENT_INBOX_API_URL": "https://staging.agentinbox.md/api",
        "NOVU_API_URL": "https://api.novu-staging.co",
        "DOCS_URL": "https://staging.agentinbox.md",
        "OPENAI_APPS_CHALLENGE": "MbIO4yH4tRys5OGhYXborRB1b_Q67jqjOO9lRpXkIVE"
      },
      "kv_namespaces": [
        {
          "binding": "CONNECTIONS",
          "id": "5f02fe813d1842daacc789eccfa438b2"
        }
      ]
    },
    "production": {
      "name": "agent-inbox-mcp",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "mcp.agentinbox.md",
          "custom_domain": true
        }
      ],
      "vars": {
        "CLERK_OAUTH_ISSUER": "https://clerk.agentinbox.md",
        "AGENT_INBOX_API_URL": "https://www.agentinbox.md/api",
        "NOVU_API_URL": "https://api.novu.co",
        "DOCS_URL": "https://www.agentinbox.md",
        "OPENAI_APPS_CHALLENGE": "MbIO4yH4tRys5OGhYXborRB1b_Q67jqjOO9lRpXkIVE"
      },
      "kv_namespaces": [
        {
          "binding": "CONNECTIONS",
          "id": "f69a59a57ba34394875cb7971af518b4"
        }
      ]
    }
  }
}
