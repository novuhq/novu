{
  "name": "@novu/human-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx biome lint apps/human-website"
        }
      }
    }
  },
  "scripts": {
    "start": "next dev --port 4300",
    "dev": "pnpm start",
    "build": "next build",
    "start:prod": "next start --port 4300",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.3.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.21",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "tailwindcss": "4.3.0",
    "typescript": "5.6.2"
  }
}
