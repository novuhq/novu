# The Novu API. /api on this site forwards to it (the CLI, the MCP server and
# the invite, verify and connect pages go through /api), and this site's server
# calls it directly. Values are inlined at build time (NEXT_PUBLIC_), so rebuild
# after changing them.
NEXT_PUBLIC_NOVU_API_URL=http://localhost:3000

# Human accounts (sign-up, /claim, the dashboard). The Human Clerk app, not the
# Novu dashboard's one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Agent Inbox Clerk app's webhook to /api/webhooks/clerk (user.created).
# Leave empty to turn the endpoint off; the first dashboard visit then sets the account up.
CLERK_WEBHOOK_SIGNING_SECRET=
# Same value as AGENT_INBOX_DASHBOARD_API_SECRET on the Novu API. Server only.
AGENT_INBOX_DASHBOARD_API_SECRET=

# The hosted Agent Inbox MCP server that ChatGPT, Claude and Cursor connect to (NV-8973). Server only.
# Leave it empty until that server runs: the Agent page then links its tool tiles to the docs.
AGENT_INBOX_MCP_URL=

# Set to true on a deployment that must stay out of search results, such as staging.agentinbox.md.
# Every route then sends `X-Robots-Tag: noindex, nofollow`, and the website pages say `noindex`.
# Leave it unset on www.agentinbox.md. Read at build time: set it on the Vercel environment, then redeploy.
SITE_NOINDEX=

# Where this dashboard is served: the value the Novu API has as HUMAN_DASHBOARD_URL. Links it hands out,
# such as an agent's public card at /p/{handle}, point here. Server only. Leave it empty to use the address
# the page was opened on, e.g. http://localhost:4300 locally.
AGENT_INBOX_DASHBOARD_URL=

# Token of Novu's Mixpanel project, the one the Novu dashboard sends to. The dashboard then counts page views
# and identifies the operator by their hidden Novu user, so their visits share a profile with the API's
# Agent Inbox events. Leave it empty to send nothing. Inlined at build time.
NEXT_PUBLIC_MIXPANEL_TOKEN=
