# Novu API the invite page talks to. Invite links carry ?region=eu when the
# EU API issued them; anything else uses the default API below. Values are
# inlined at build time (NEXT_PUBLIC_), so rebuild after changing them.
NEXT_PUBLIC_NOVU_API_URL=http://localhost:3000
# NEXT_PUBLIC_NOVU_API_URL_EU=https://eu.api.novu.co

# Human accounts (sign-up, /claim, /account). The Human Clerk app, not the
# Novu dashboard's one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Human Clerk app's webhook to /api/webhooks/clerk (user.created).
# Leave empty to turn the endpoint off; the first dashboard visit then sets the account up.
CLERK_WEBHOOK_SIGNING_SECRET=
# Same value as HUMAN_DASHBOARD_API_SECRET on the Novu API. Server only.
HUMAN_DASHBOARD_API_SECRET=
