{
  "name": "@novu/human-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "nx": {
    "tags": [
      "type:app"
    ],
    "implicitDependencies": [
      "@agentinbox/cli"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx biome lint apps/human-dashboard"
        }
      }
    }
  },
  "scripts": {
    "start": "next dev --port 4300",
    "dev": "pnpm start",
    "build": "next build",
    "start:prod": "next start --port 4300",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.9",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "mixpanel-browser": "^2.52.0",
    "next": "16.3.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.21",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.0",
    "@types/mixpanel-browser": "^2.49.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.0",
    "typescript": "5.6.2",
    "vitest": "^4.1.11"
  }
}
