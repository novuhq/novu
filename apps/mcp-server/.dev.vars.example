# Local development configuration for `pnpm dev`.
# Copy this file to `.dev.vars` (gitignored) and adjust the values.

# Novu API base URL this deployment proxies to. Point it at your local
# self-hosted Novu API for local development, or a cloud region to test
# against Novu Cloud.
NOVU_API_URL="http://localhost:3000"

# Display label surfaced by the `whoami` tool (e.g. "us", "eu", "local").
NOVU_REGION="local"

# Keys of the Clerk instance your Novu API trusts. With both set, the server
# offers OAuth: clients sign in with Clerk and every token is verified with
# Clerk, audience included. Leave either empty for API-key-only mode (the
# self-hosted story).
CLERK_PUBLISHABLE_KEY=""

# Also stores agent feedback: when set, the server registers Clerk's
# `submit_feedback` tool; leave empty to omit it.
CLERK_SECRET_KEY=""
