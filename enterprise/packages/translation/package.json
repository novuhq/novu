{
  "name": "@novu/ee-translation",
  "version": "2.0.18",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build:watch",
    "build": "node ./check-ee.mjs",
    "build:esm": "node_modules/.bin/tsc -p tsconfig.json",
    "build:watch": "node_modules/.bin/tsc -w -p tsconfig.json",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@handlebars/parser": "^2.1.0",
    "@novu/application-generic": "workspace:*",
    "@novu/ee-auth": "workspace:*",
    "@novu/ee-shared-services": "workspace:*",
    "@novu/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "deep-object-diff": "^1.1.9",
    "i18next": "^23.7.11",
    "lodash": "^4.18.0",
    "multer": "^2.1.1",
    "shortid": "^2.2.17"
  },
  "devDependencies": {
    "@types/chai": "^4.2.11",
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^8.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/sinon": "^9.0.0",
    "chai": "^4.2.0",
    "cross-env": "^7.0.3",
    "sinon": "^9.2.4",
    "typescript": "6.0.3",
    "liquidjs": "^10.27.1"
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.7",
    "@novu/dal": "workspace:*"
  }
