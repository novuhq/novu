{
  "name": "@novu/ee-shared-services",
  "version": "2.0.5",
  "description": "Generic service used inside of Novu's different services - can not be depended on application-generic",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "private": true,
  "repository": {
    "url": "https://github.com/novuhq/novu",
    "directory": "packages/nest"
  },
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "start": "npm run build:watch",
    "prebuild": "rimraf build",
    "build": "node ./check-ee.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "fix": "run-s fix:*",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "jest src --watch",
    "reset-hard": "git clean -dfx && git reset --hard && pnpm install",
    "prepare-release": "run-s reset-hard test",
    "typecheck:spec": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@handlebars/parser": "^2.1.0",
    "@novu/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "sinon": "^9.2.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.27",
    "@novu/dal": "workspace:*"
  }
}
