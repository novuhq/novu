{
  "name": "@novu/ee-auth",
  "version": "2.0.18",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "node ./check-ee.mjs",
    "build:esm": "node_modules/.bin/tsc -p tsconfig.json",
    "build:watch": "node_modules/.bin/tsc -w -p tsconfig.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "test": "if [ -e src ]; then pnpm test-ee; else echo 'skip test: the enterprise source (.source) is not checked out'; fi",
    "test-ee": "cross-env NODE_ENV=test mocha --timeout 10000 --require @novu/testing/swc-register --exit 'src/**/*.spec.ts'"
  },
  "dependencies": {
    "@better-auth/sso": "^1.6.23",
    "@clerk/backend": "^3.4.11",
    "@clerk/express": "^2.1.19",
    "@novu/application-generic": "workspace:*",
    "@novu/dal": "workspace:*",
    "@novu/providers": "workspace:*",
    "@novu/shared": "workspace:*",
    "@novu/stateless": "workspace:*",
    "better-auth": "^1.6.23",
    "better-call": "^1.3.7",
    "passport-custom": "^1.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.22.1",
    "svix": "^1.96.1"
  },
  "devDependencies": {
    "@novu/testing": "workspace:*",
    "@clerk/shared": "^4.12.2",
    "@clerk/types": "^4.48.0",
    "@types/mocha": "^8.0.1",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^3.0.3",
    "@types/sinon": "^9.0.0",
    "chai": "^4.2.0",
    "cross-env": "^7.0.3",
    "mocha": "^11.7.6",
    "sinon": "^9.2.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/swagger": "11.4.7",
    "passport": "0.7.0",
    "passport-jwt": "^4.0.0"
  }
}
