{
  "name": "@novu/shared",
  "version": "2.10.0",
  "description": "",
  "scripts": {
    "start": "npm run start:dev",
    "afterinstall": "pnpm build",
    "prebuild": "rimraf dist",
    "build": "npm run build:cjs && npm run build:esm",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.json",
    "build:watch": "cross-env node_modules/.bin/tsc -p tsconfig.json -w --preserveWatchOutput",
    "postbuild": "npm run check:circulars",
    "start:dev": "pnpm build:watch",
    "precommit": "lint-staged",
    "check": "biome check . && npm run check:scripts",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "watch:test": "pnpm test --watch",
    "check:circulars": "madge --circular --extensions ts ./src",
    "generate:slack-schema": "node scripts/generate-slack-override-schema.ts",
    "generate:telegram-schema": "node scripts/generate-telegram-override-schema.ts",
    "generate:whatsapp-schema": "node scripts/generate-whatsapp-override-schema.ts",
    "generate:fcm-schema": "node scripts/generate-fcm-override-schema.ts"
  },

  "author": "",
  "license": "ISC",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist/",
    "docs/agent-onboarding.md",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.js"
    },
    "./utils": {
      "require": "./dist/cjs/utils/index.js",
      "import": "./dist/esm/utils/index.js",
      "types": "./dist/esm/utils/index.d.js"
    },
    "./utils/private-ip-classification": {
      "require": "./dist/cjs/utils/private-ip-classification.js",
      "import": "./dist/esm/utils/private-ip-classification.js",
      "types": "./dist/esm/utils/private-ip-classification.d.ts"
    },
    "./utils/outbound-ssrf-allow-list": {
      "require": "./dist/cjs/utils/outbound-ssrf-allow-list.js",
      "import": "./dist/esm/utils/outbound-ssrf-allow-list.js",
      "types": "./dist/esm/utils/outbound-ssrf-allow-list.d.ts"
    },
    "./utils/ssrf-url-validation": {
      "require": "./dist/cjs/utils/ssrf-url-validation.js",
      "import": "./dist/esm/utils/ssrf-url-validation.js",
      "types": "./dist/esm/utils/ssrf-url-validation.d.ts"
    },
    "./utils/safe-outbound-http": {
      "require": "./dist/cjs/utils/safe-outbound-http.js",
      "import": "./dist/esm/utils/safe-outbound-http.js",
      "types": "./dist/esm/utils/safe-outbound-http.d.ts"
    },
    "./utils/validate-smtp-outbound-target": {
      "require": "./dist/cjs/utils/validate-smtp-outbound-target.js",
      "import": "./dist/esm/utils/validate-smtp-outbound-target.js",
      "types": "./dist/esm/utils/validate-smtp-outbound-target.d.ts"
    },
    "./provider-overrides/slack": {
      "types": "./dist/esm/consts/providers/provider-overrides/slack/index.d.ts",
      "require": "./dist/cjs/consts/providers/provider-overrides/slack/index.js",
      "import": "./dist/esm/consts/providers/provider-overrides/slack/index.js"
    },
    "./provider-overrides/telegram": {
      "types": "./dist/esm/consts/providers/provider-overrides/telegram/index.d.ts",
      "require": "./dist/cjs/consts/providers/provider-overrides/telegram/index.js",
      "import": "./dist/esm/consts/providers/provider-overrides/telegram/index.js"
    },
    "./provider-overrides/whatsapp": {
      "types": "./dist/esm/consts/providers/provider-overrides/whatsapp/index.d.ts",
      "require": "./dist/cjs/consts/providers/provider-overrides/whatsapp/index.js",
      "import": "./dist/esm/consts/providers/provider-overrides/whatsapp/index.js"
    },
    "./provider-overrides/fcm": {
      "types": "./dist/esm/consts/providers/provider-overrides/fcm/index.d.ts",
      "require": "./dist/cjs/consts/providers/provider-overrides/fcm/index.js",
      "import": "./dist/esm/consts/providers/provider-overrides/fcm/index.js"
    },
    "./docs/agent-onboarding.md": "./docs/agent-onboarding.md"
  },
  "dependencies": {
    "lru-cache": "^11.5.1"
  },
  "devDependencies": {
    "@grammyjs/types": "4.0.0",
    "@slack/web-api": "7.17.0",
    "firebase-admin": "^13.3.0",
    "madge": "^8.0.0",
    "rimraf": "^3.0.2",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "5.6.2",
    "vitest": "^4.1.0"
  },

  "nx": {
    "tags": [
      "type:package"
    ]
  }
}
