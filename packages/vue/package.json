{
  "name": "@novu/vue",
  "version": "3.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/novuhq/novu",
    "directory": "packages/vue"
  },
  "homepage": "https://novu.co",
  "description": "Novu <Inbox /> Vue SDK",
  "author": "Novu",
  "license": "ISC",
  "type": "module",
  "main": "./dist/cjs/server/index.cjs",
  "browser": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.cjs"
        }
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/server/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/esm/hooks/index.d.ts",
        "default": "./dist/esm/hooks/index.js"
      },
      "require": {
        "types": "./dist/cjs/hooks/index.d.cts",
        "default": "./dist/cjs/hooks/index.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/esm/themes/index.d.ts",
        "default": "./dist/esm/themes/index.js"
      },
      "require": {
        "types": "./dist/cjs/themes/index.d.cts",
        "default": "./dist/cjs/themes/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/server/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/esm/components/index.d.ts",
        "default": "./dist/esm/components/index.js"
      },
      "require": {
        "types": "./dist/cjs/components/index.d.ts",
        "default": "./dist/cjs/components/index.js"
      }
    }
  },
  "files": [
    "dist",
    "dist/esm/**/*",
    "dist/cjs/**/*",
    "hooks/**/*",
    "themes/**/*",
    "server/**/*"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vite",
    "build": "pnpm build:esm && pnpm build:cjs && pnpm run check-exports",
    "build:esm": "cross-env BUILD_TYPE=esm vite build",
    "build:cjs": "cross-env BUILD_TYPE=cjs vite build",
    "lint": "eslint src",
    "check-exports": "attw --pack ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/node": "^20.14.12",
    "@types/vue": "*",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/runtime-core": "^3.5.13",
    "cross-env": "^7.0.3",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "esbuild-plugin-vue": "^0.2.4",
    "tsup": "^8.2.1",
    "typescript": "5.5.4",
    "unplugin-vue": "^6.0.1",
    "vue-tsc": "^2.2.8"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "dependencies": {
    "@novu/js": "^3.0.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "vite": "^6.2.6",
    "vite-plugin-dts": "^3.6.0"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
}
