{
	"name": "@novu/translation",
	"version": "2.10.0-alpha.0",
	"description": "AI-powered translation services for Novu notification content",
	"main": "build/main/index.js",
	"typings": "build/main/index.d.ts",
	"private": true,
	"license": "MIT",
	"keywords": [
		"novu",
		"translation",
		"i18n",
		"localization",
		"openai"
	],
	"scripts": {
		"start": "npm run watch:build",
		"prebuild": "rimraf build",
		"build": "tsc -p tsconfig.json",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"watch:build": "tsc -p tsconfig.json -w",
		"watch:test": "jest src --watch",
		"test": "jest src",
		"reset-hard": "git clean -dfx && git reset --hard && pnpm install"
	},
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"@nestjs/common": ">=10.0.0",
		"@nestjs/core": ">=10.0.0"
	},
	"dependencies": {
		"@novu/application-generic": "workspace:*",
		"@novu/dal": "workspace:*",
		"@novu/shared": "workspace:*",
		"class-transformer": "0.5.1",
		"class-validator": "0.14.1",
		"mongoose": "^8.0.0",
		"openai": "^4.20.0",
		"uuid": "^9.0.0"
	},
	"devDependencies": {
		"@nestjs/testing": "^10.0.0",
		"@types/jest": "29.5.2",
		"@types/node": "^20.15.0",
		"@types/uuid": "^9.0.0",
		"jest": "^29.7.0",
		"rimraf": "^3.0.2",
		"ts-jest": "^29.1.0",
		"typescript": "5.6.2"
	},
	"files": [
		"build/main",
		"!**/*.spec.*",
		"!**/*.json",
		"LICENSE",
		"README.md"
	],
	"nx": {
		"tags": [
			"type:package"
		]
	}
}
