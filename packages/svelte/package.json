{
  "name": "@novu/svelte",
  "version": "3.19.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/novuhq/novu",
    "directory": "packages/svelte"
  },
  "homepage": "https://novu.co",
  "description": "Novu <Inbox /> Svelte SDK",
  "author": "Novu",
  "license": "ISC",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "package": "svelte-package",
    "build": "pnpm run check && pnpm run package",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^20.0.3",
    "svelte": "5.57.1",
    "svelte-check": "^4.0.0",
    "typescript": "5.6.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@novu/js": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
