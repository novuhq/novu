{
  "name": "@novu/chat-adapter-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web chat adapter for Novu conversational agents (Chat SDK)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "afterinstall": "pnpm build",
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "watch:build": "tsc -p tsconfig.json -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "nanoid": "^5.1.16"
  },
  "peerDependencies": {
    "chat": ">=4.33.0"
  },
  "devDependencies": {
    "chat": "^4.33.0",
    "rimraf": "~3.0.2",
    "typescript": "5.6.2",
    "vitest": "^4.1.0",
    "zod": "3.25.20"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
}
