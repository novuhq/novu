# =============================================================================
# ReNovu - Self-Hosted Configuration
# =============================================================================
# Copy this to .env and customize for your environment.
# CHANGE ALL SECRETS BEFORE PRODUCTION USE!
# =============================================================================

# Node Environment
NODE_ENV=local

# MongoDB
MONGO_USER=renovu
MONGO_PASSWORD=renovu-dev-password

# Redis (leave empty for no password in development)
REDIS_PASSWORD=

# Security - MUST CHANGE IN PRODUCTION
JWT_SECRET=renovu-jwt-secret-change-in-production
STORE_ENCRYPTION_KEY=renovu-32char-encryption-key!!!!
NOVU_SECRET_KEY=renovu-secret-key-change-in-prod

# URLs (for local development)
API_ROOT_URL=http://localhost:3000
FRONT_BASE_URL=http://localhost:4000
VITE_API_HOSTNAME=http://localhost:3000
VITE_WEBSOCKET_HOSTNAME=http://localhost:3002

# Ports
API_PORT=3000
WS_PORT=3002
DASHBOARD_PORT=4000

# S3/Storage (optional - leave empty to disable)
S3_REGION=us-east-1
S3_BUCKET_NAME=renovu-local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring (optional)
SENTRY_DSN=
