{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["es2024", "dom"],
    "module": "commonjs",
    "noImplicitAny": false,
    "noUncheckedSideEffectImports": false,
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "target": "es2021"
  }
}
